[sub_resource type="GDScript" id="GDScript_6uqi0"]
script/source = "extends MeshInstance3D

func get_random_point() -> Vector3:
	var plane_mesh: PlaneMesh = mesh as PlaneMesh
	if plane_mesh == null:
		push_warning(\"FxPanel needs a PlaneMesh.\")
		return Vector3.ZERO

	var plane_size: Vector2 = plane_mesh.size

	# PlaneMesh.orientation = 2 (FACE_Z) lies in the local XY plane.
	return Vector3(
		randf_range(-plane_size.x / 2.0, plane_size.x / 2.0),
		randf_range(-plane_size.y / 2.0, plane_size.y / 2.0),
		0.0
	)
"

